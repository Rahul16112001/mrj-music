# MRJ Music Production Environment Variables

# PostgreSQL Database Connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://mrj_user:mrj_secure_password@localhost:5432/mrj_music_db"

# JWT Authentication Secrets
JWT_SECRET="mrj_super_secure_jwt_access_secret_key_minimum_32_characters"
JWT_REFRESH_SECRET="mrj_super_secure_jwt_refresh_secret_key_minimum_32_characters"

# Server Port
PORT=5005
NODE_ENV=production
